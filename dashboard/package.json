{
  "name": "finora-dq-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/voice-assets.mjs && next dev",
    "dev:mock": "NEXT_PUBLIC_DQ_MOCKS=1 NEXT_PUBLIC_VOICE=1 node scripts/voice-assets.mjs && NEXT_PUBLIC_DQ_MOCKS=1 NEXT_PUBLIC_VOICE=1 next dev",
    "build": "node scripts/voice-assets.mjs && next build && node scripts/check-no-mocks.mjs out",
    "build:mock": "NEXT_PUBLIC_VOICE=1 node scripts/voice-assets.mjs && NEXT_PUBLIC_DQ_MOCKS=1 DQ_MOCK_EXPORT=1 NEXT_PUBLIC_VOICE=1 next build",
    "serve": "node scripts/serve-static.mjs out 4173",
    "serve:mock": "node scripts/serve-static.mjs out-mock 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/react": "1.22.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "clsx": "2.1.1",
    "d3-array": "3.2.5",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
